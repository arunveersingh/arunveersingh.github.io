---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Launches from '../components/Launches.astro';
import Mark from '../components/Mark.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { launchesForPath } from '../data/launches';
import { brand, nav, site, withBase } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** `article` for essays, videos, and build notes. `website` for indexes. */
  ogType?: 'website' | 'article';
  /** ISO date rendered as `article:published_time`. */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Set on the 404 page so it stays out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

// The publication is the suffix on every page. The author's name is on the
// home title because that is what people search for; elsewhere it lives in
// the author meta and the footer byline.
const pageTitle = title
  ? `${title} · ${brand.name}`
  : `${brand.name} — ${site.author} on engineering judgment`;
// Social cards want the bare headline, not the breadcrumbed document title.
const socialTitle = title ? `${title} — ${brand.name}` : `${brand.name} — ${site.tagline}`;

const navIcon = {
  '/': 'studio',
  '/essays/': 'essay',
  '/watch/': 'play',
  '/courses/': 'course',
  '/builds/': 'build',
  '/about/': 'about',
} as const;

function iconFor(href: string): (typeof navIcon)[keyof typeof navIcon] {
  const path = href.endsWith('/') ? href : `${href}/`;
  if (path in navIcon) return navIcon[path as keyof typeof navIcon];
  return 'studio';
}

const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const home = withBase('/').replace(/\/+$/, '') || '/';
const launchIds = launchesForPath(Astro.url.pathname).map((item) => item.id);

// `Astro.site` comes from astro.config.mjs, so these stay absolute in the built
// output. Social scrapers and canonical tags both reject relative URLs.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL(withBase('og.png'), Astro.site).href : withBase('og.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Light paper. A later script only replaces this when the visitor has
        saved dark. */}
    <meta name="theme-color" content="#e8e4db" />

    {/*
      Light is the default, including on a phone set to dark. A saved choice
      is the only override. `is:inline` runs before first paint, so the saved
      dark theme does not flash white first.
    */}
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark') theme = 'dark';
        } catch (error) {
          /* blocked storage: stay on the light default */
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        var chrome = document.querySelector('meta[name="theme-color"]');
        if (chrome) chrome.content = theme === 'dark' ? '#000000' : '#e8e4db';
      })();
    </script>
    {/*
      Same idea as the theme script: decide before first paint whether the
      launch bar is still unseen, so a dismissed notice does not flash and
      the header does not jump. The ids are the launches on this page.
    */}
    <script is:inline define:vars={{ launchIds }}>
      (function (ids) {
        var quiet = true;
        try {
          var seen = JSON.parse(localStorage.getItem('launches-seen') || '[]');
          if (!Array.isArray(seen)) seen = [];
          quiet = ids.every(function (id) {
            return seen.indexOf(id) !== -1;
          });
        } catch (error) {
          quiet = ids.length === 0;
        }
        document.documentElement.dataset.launches = quiet || ids.length === 0 ? 'quiet' : 'show';
      })(launchIds);
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {/* What the site is called when pinned to a home screen or a taskbar. */}
    <meta name="application-name" content={brand.name} />
    <meta name="apple-mobile-web-app-title" content={brand.name} />
    {/* noindex + canonical is a contradictory signal, so pages opt into one or
        the other. A 404 in particular is served at arbitrary URLs and has no
        canonical form. */}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand.name} — ${site.tagline} ${site.author}, ${brand.domain}`} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@oopsfeedmecode" />

    {/* SVG first for browsers that take it; the .ico and touch icon are
        rendered from the same mark by `npm run icons`. */}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" type="image/x-icon" sizes="32x32" href={withBase('favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${brand.name} — essays`} href={withBase('rss.xml')} />
    <link rel="sitemap" type="application/xml" href={withBase('sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Three faces, three jobs: mono for metadata, Newsreader for headlines,
        Inter for reading. Previously Inter did all three and Barlow Condensed
        was downloaded at two weights without being used anywhere. */}
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=Inter:wght@400;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        {/* Masthead: the mark plus the domain as a wordmark. The author is a
            byline (hero and footer), not the masthead — the domain is the
            brand and the chrome should say so on every page. */}
        <a class="brand" href={withBase('/')} aria-label={`${brand.name} — home`}>
          <Mark class="brand-mark" />
          <span class="brand-word">{brand.wordmark}</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {
              nav.map((item) => {
                const href = withBase(item.href);
                const path = href.replace(/\/+$/, '') || '/';
                const current = here === path || (path !== home && here.startsWith(`${path}/`));
                return (
                  <li>
                    <a href={href} aria-current={current ? 'page' : undefined}>
                      <Icon name={iconFor(item.href)} />
                      <span>{item.label}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="content" class="stage-main">
      {/* In the page, not the fixed header. A phone with several launches
          was clipping the bar once the header ran out of reserved height. */}
      <Launches />
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <ul>
          <li><a href={site.github}>GitHub</a></li>
          <li><a href={site.linkedin}>LinkedIn</a></li>
          <li><a href={site.x}>X</a></li>
          {
            site.youtube.map((channel) => (
              <li>
                <a href={channel.href}>{channel.name}</a>
              </li>
            ))
          }
          <li><a href={`mailto:${site.email}`}>Email</a></li>
          <li><a href={withBase('rss.xml')}>RSS</a></li>
        </ul>
        {/* The byline lives here on every page: the domain, then the person
            behind it. The masthead above says only the brand. */}
        <p class="site-footer-byline">
          <a href={withBase('/')}>{brand.domain}</a> · {site.author} · Canonical writing, not a feed
        </p>
      </div>
    </footer>
  </body>
</html>
