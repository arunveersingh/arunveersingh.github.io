---
import Base from '../layouts/Base.astro';
import Player from '../components/Player.astro';
import {
  brand,
  channelById,
  REASON_FROM_COUNT,
  reasonFrom,
  site,
  withBase,
  yearsShipping,
} from '../data/site';
import { featuredSkills, skillCount, skillUrl } from '../data/skills';
import { transitionName } from '../lib/motion';
import {
  canonVideos,
  featuredEssays,
  leadVideo,
  publishedBuilds,
  leadBuild,
  selectedBuilds,
  summaryFor,
} from '../lib/content';

const judgment = await canonVideos();
const selected = await selectedBuilds();
const essays = await featuredEssays();
const allBuilds = await publishedBuilds();

const featuredBuild = await leadBuild();
const featuredVideo = await leadVideo();
const restSkills = skillCount - featuredSkills.length;

// The reel keyframes in global.css are written for an exact word count, so a
// mismatch would desynchronise the animation silently. Fail the build instead.
if (reasonFrom.length !== REASON_FROM_COUNT) {
  throw new Error(
    `reasonFrom has ${reasonFrom.length} words but the CSS reel is built for ` +
      `${REASON_FROM_COUNT}. Update the @keyframes reason-reel stops in ` +
      `src/styles/global.css and REASON_FROM_COUNT together.`,
  );
}

const [english, hindi] = site.youtube;
// Which channel the featured talk came from, so the player can attribute itself.
const featuredChannel = featuredVideo ? channelById(featuredVideo.data.channel) : undefined;
---

<Base>
  <section class="hero">
    <div class="hero-inner">
      {/*
        The brand leads. "Reason from ___" is the domain, so it is the h1 rather
        than a band further down, where it read as a subordinate section.

        Progressive enhancement on purpose. The served HTML contains exactly
        "Reason from first principles" — one clean sentence. Putting all six
        phrases in the markup made the h1's text content read as
        "Reason fromfirst principlesevidenceconstraints…", which is fine for
        screen readers (the reel is aria-hidden) but bad for crawlers, which read
        DOM text. The script below swaps in the reel; with JS off you get the
        static canonical line, which is a perfectly good hero.

        Safe as the LCP element: the reel's first word sits at translateY(0), so
        nothing is hidden at first paint. That is the difference between a reel
        and a fade-in, and it is why my earlier "never animate the h1" rule does
        not apply here.
      */}
      {/* The masthead now says the brand, so the author is introduced here —
          a byline over the wordmark line, in the site's kicker voice. */}
      <p class="kicker hero-byline">{site.author} · {brand.strap}</p>
      <h1 class="reason-line" data-reason={JSON.stringify(reasonFrom)}>
        <span>Reason from</span>
        <span class="reason-slot">{reasonFrom[0]}</span>
      </h1>

      <p class="hero-claim">AI should force you not to make mistakes.</p>
      {/* "English" and "Hindi" are the channel links. The words were already in
          the sentence, so this adds reach without adding a single pixel. */}
      <p class="lede">
        I write, teach, and ship the standard I want tools to hold. The public artifact is{' '}
        <a href={site.ai}>arunveersingh/ai</a>
        {' '}— {skillCount} agent skills that refuse to proceed on a guess. I teach the same
        standard in{' '}
        <a href={english.href}>English</a>
        {' '}and{' '}
        <a href={hindi.href}>Hindi</a>. Tutorials stay in the library. Judgment stays here.
      </p>
      <div class="actions">
        {
          featuredBuild && (
            <a class="pill pill-solid" href={withBase(`/builds/${featuredBuild.id}/`)}>
              Read the standard
            </a>
          )
        }
        <a class="pill" href={withBase('/watch/')}>Selected talks</a>
      </div>
    </div>
  </section>

  <script>
    // Swaps the single canonical word for the full stack. Kept in JS so the
    // served h1 stays one clean sentence for crawlers; with JS off the static
    // word remains, which is a perfectly good hero.
    const line = document.querySelector<HTMLElement>('.reason-line[data-reason]');
    const slot = line?.querySelector<HTMLElement>('.reason-slot');
    if (line && slot) {
      let words: string[] = [];
      try {
        words = JSON.parse(line.dataset.reason ?? '[]');
      } catch {
        words = [];
      }
      if (words.length > 1) {
        // Words stack in one grid cell and are distinguished by motion, so the
        // stack itself is decoration; the accessible name comes from the label.
        slot.setAttribute('aria-hidden', 'true');
        slot.textContent = '';
        for (const word of words) {
          const item = document.createElement('span');
          item.textContent = word;
          slot.append(item);
        }

        const label = document.createElement('span');
        label.className = 'visually-hidden';
        label.textContent = words[0];
        slot.after(label);
      }
    }
  </script>

  <section class="band band-lead">
    {/* Sections need a heading or screen-reader users get an unlabelled
        landmark. These three carry no visible kicker, so the label is
        visually hidden rather than invented on screen. */}
    <h2 class="visually-hidden">The standard and the talks</h2>
    <div class="windows">
      <div class="window">
        <div class="window-head">
          <span>The standard</span>
          {
            featuredBuild && (
              <a href={withBase(`/builds/${featuredBuild.id}/`)}>Read the note →</a>
            )
          }
        </div>
        {/* Each skill links to its own directory. This used to be one anchor
            wrapped around the whole list, so named skills looked clickable
            but only the block was. */}
        <ul class="term">
          {
            featuredSkills.map((skill) => (
              <li>
                <a href={skillUrl(skill.name)}>
                  <span class="ok" aria-hidden="true">▸</span>
                  <span>{skill.name}</span>
                  <em>{skill.note}</em>
                </a>
              </li>
            ))
          }
        </ul>
        {restSkills > 0 && <p class="term-more">+ {restSkills} more in the repo</p>}
      </div>

      <div class="window">
        <div class="window-head">
          <span>Judgment, on camera</span>
          <a href={withBase('/watch/')}>All talks →</a>
        </div>
        {
          featuredVideo?.data.youtubeId && (
            <Player
              youtubeId={featuredVideo.data.youtubeId}
              title={featuredVideo.data.title}
              transitionName={transitionName('talk', featuredVideo.id)}
            />
          )
        }
        {/* The player used to sit here unlabelled — you had to press play to
            learn what the talk was. Naming it also puts the channel on the
            homepage as attribution rather than as promotion. */}
        {
          featuredVideo && featuredChannel && (
            <div class="window-caption">
              <a class="quiet" href={withBase(`/watch/${featuredVideo.id}/`)}>
                {featuredVideo.data.title}
              </a>
              <p class="meta">
                <a href={featuredChannel.href}>{featuredChannel.name}</a>
                {` · ${featuredChannel.language}`}
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="band">
    <h2 class="visually-hidden">By the numbers</h2>
    <div class="stats">
      <p class="stat">
        <strong>{yearsShipping}</strong>
        <span>years shipping production systems</span>
      </p>
      <p class="stat">
        <strong>{skillCount}</strong>
        <span>agent skills that will halt a bad plan</span>
      </p>
      <p class="stat">
        <strong>{judgment.length}</strong>
        <span>selected talks on judgment, not syntax</span>
      </p>
    </div>
  </section>

  {
    selected.length > 1 && (
      <section class="band">
        <h2 class="kicker">Selected systems work</h2>
        <ol class="index-list">
          {selected.map((entry) => (
            <li>
              <a href={withBase(`/builds/${entry.id}/`)}>
                <span class="meta">{new URL(entry.data.repo).pathname.slice(1)}</span>
                <strong class="vt" style={`--vt: ${transitionName('build', entry.id)}`}>
                  {entry.data.title}
                </strong>
                {entry.data.problem && <em>{entry.data.problem}</em>}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/* Renders only when there is writing worth leading with, so the section
      disappears cleanly rather than showing an empty promise. */}
  {
    essays.length > 0 && (
      <section class="band">
        <h2 class="kicker">Writing</h2>
        <div class="news">
          {essays.map((entry) => {
            const summary = summaryFor(entry.data.title, entry.data.description);
            return (
              <a href={withBase(`/essays/${entry.id}/`)}>
                <span class="meta">
                  <time datetime={entry.data.published.toISOString()}>
                    {entry.data.published.toLocaleDateString('en-GB', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                </span>
                <strong class="vt" style={`--vt: ${transitionName('essay', entry.id)}`}>
                  {entry.data.title}
                </strong>
                {summary && <p>{summary}</p>}
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="band band-quiet">
    <h2 class="visually-hidden">Colophon</h2>
    <p class="muted colophon">
      {allBuilds.length} public repos sit behind this page. It leads with the {selected.length} that
      prove the standard — the rest is a lab, and{' '}
      <a href={site.github}>lives on GitHub</a>, not here.
    </p>
    {/* Both channels stated plainly at the end, where a colophon belongs — no
        subscribe button, no count, no badge. */}
    <p class="muted colophon">
      Teaching happens on{' '}
      <a href={english.href}>{english.name}</a>
      {' '}in {english.language} and{' '}
      <a href={hindi.href}>{hindi.name}</a>
      {' '}in {hindi.language}. The {judgment.length} talks worth arguing with are{' '}
      <a href={withBase('/watch/')}>collected here</a>.
    </p>
  </section>
</Base>
