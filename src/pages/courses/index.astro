---
import Base from '../../layouts/Base.astro';
import { courses } from '../../data/site';

const count: number = courses.length;
---

<Base
  title="Courses"
  description="Written courses, read in the browser. Each card opens the course in a new tab."
>
  <div class="page">
    <h1 class="kicker">Courses</h1>
    <p class="lede page-lede">
      {count === 1 ? 'One course.' : `${count} courses.`} Free to read. A card opens the book in a new tab.
    </p>
    <div class="news course-cards">
      {
        courses.map((course) => (
          <a href={course.href} target="_blank" rel="noopener noreferrer">
            <span class="course-cover" aria-hidden="true">
              {course.cover ? (
                <img src={course.cover} alt="" />
              ) : (
                <svg viewBox="0 0 640 400" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="36" y="78" width="168" height="78" rx="2" />
                  <rect x="236" y="48" width="168" height="78" rx="2" />
                  <rect x="236" y="168" width="168" height="78" rx="2" />
                  <rect x="436" y="108" width="168" height="78" rx="2" />
                  <path d="M204 117H236M404 87H436M404 207H436M320 126V168" />
                </svg>
              )}
              <span class="course-cover-label">Free</span>
            </span>
            <span class="meta">{course.meta}</span>
            <strong>{course.title}</strong>
            <p>{course.summary}</p>
            <span class="visually-hidden">Opens in a new tab.</span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
