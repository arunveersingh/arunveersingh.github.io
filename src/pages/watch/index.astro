---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Player from '../../components/Player.astro';
import Thumb from '../../components/Thumb.astro';
import { channelById, site, withBase } from '../../data/site';
import { canonVideos, leadVideo, publishedVideos } from '../../lib/content';
import { transitionName } from '../../lib/motion';
import { latest, shortsBySeries } from '../../lib/related';

const videos = await publishedVideos();
const selected = await canonVideos();
// Pinned by the order of `leadVideoNeedles`, not by whichever match is newest.
const lead = await leadVideo();
const fresh = latest(videos).filter((v) => v.id !== lead?.id);
const inCut = (v: (typeof videos)[number]) => selected.some((item) => item.id === v.id);
// Long talks only; Shorts get their own grouped section below.
const library = videos.filter((video) => !inCut(video) && video.data.format !== 'short');
const shortGroups = shortsBySeries(videos.filter((v) => !inCut(v)));
const shortCount = shortGroups.reduce((n, g) => n + g.items.length, 0);
---

<Base title="Watch" description="Selected talks on engineering judgment, playable here.">
  <div class="page">
    <h1 class="kicker"><span class="icon-disc disc-sky page-mark"><Icon name="play" /></span>Watch</h1>
    <p class="lede page-lede">
      Selected talks on judgment first. Below that is the library pulled from{' '}
      <a href={site.youtube[0].href}>{site.youtube[0].name}</a>
      {' '}and{' '}
      <a href={site.youtube[1].href}>{site.youtube[1].name}</a>
      {' '}— {videos.length} indexed here, {selected.length} in the cut. New uploads appear on their own.
    </p>

    {
      fresh.length > 0 && (
        <>
          <p class="kicker">Latest</p>
          <ol class="clip-list">
            {fresh.map((video) => (
              <li>
                <a class="clip" href={withBase(`/watch/${video.id}/`)}>
                  <Thumb youtubeId={video.data.youtubeId!} title={video.data.title} transitionName={transitionName('talk', video.id)} />
                  <span>
                    <span class="meta">{channelById(video.data.channel).name} · {video.data.published.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</span>
                    <strong>{video.data.title}</strong>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </>
      )
    }

    {
      lead?.data.youtubeId && (
        <div class="theater" data-theater>
          <div class="theater-stage">
            <Player youtubeId={lead.data.youtubeId} title={lead.data.title} />
            <div class="theater-copy" data-theater-copy aria-live="polite">
              <p class="meta" data-theater-channel>{channelById(lead.data.channel).name}</p>
              <h2 data-theater-title>{lead.data.title}</h2>
              <p data-theater-thesis>{lead.data.thesis}</p>
            </div>
          </div>
          <ol class="clip-list theater-list">
            {selected.map(
              (video) =>
                video.data.youtubeId && (
                  <li>
                    <button
                      class:list={['clip', { 'is-current': video.id === lead.id }]}
                      type="button"
                      data-id={video.data.youtubeId}
                      data-title={video.data.title}
                      data-thesis={video.data.thesis}
                      data-channel={channelById(video.data.channel).name}
                    >
                      <Thumb youtubeId={video.data.youtubeId} title={video.data.title} />
                      <span>
                        <span class="meta">{channelById(video.data.channel).name}</span>
                        <strong>{video.data.title}</strong>
                      </span>
                    </button>
                  </li>
                ),
            )}
          </ol>
        </div>
      )
    }

    {
      library.length > 0 && (
        <>
          <p class="kicker" style="margin-top: 2.5rem;">Library</p>
          <ol class="clip-list">
            {library.map(
              (video) =>
                video.data.youtubeId && (
                  <li>
                    <a class="clip" href={withBase(`/watch/${video.id}/`)}>
                      {/* Morphs into the player on the detail page. Only library
                          items get a name: theater buttons play inline and never
                          navigate, and naming both would collide in-document. */}
                      <Thumb
                        youtubeId={video.data.youtubeId}
                        title={video.data.title}
                        transitionName={fresh.some((f) => f.id === video.id) ? undefined : transitionName('talk', video.id)}
                      />
                      <span>
                        <span class="meta">{channelById(video.data.channel).name}</span>
                        <strong>{video.data.title}</strong>
                      </span>
                    </a>
                  </li>
                ),
            )}
          </ol>
        </>
      )
    }

    {
      shortCount > 0 && (
        <details class="archive" style="margin-top: 2.5rem;">
          <summary>
            <span class="archive-label">Shorts</span>
            <span class="archive-count">{shortCount} short{shortCount === 1 ? '' : 's'}, by series</span>
          </summary>
          {shortGroups.map((group) => (
            <>
              <p class="kicker" style="margin-top: 1.5rem;">{group.series}</p>
              <ol class="clip-list">
                {group.items.map((video) => (
                  <li>
                    <a class="clip" href={withBase(`/watch/${video.id}/`)}>
                      <Thumb youtubeId={video.data.youtubeId!} title={video.data.title} />
                      <span>
                        <span class="meta">{channelById(video.data.channel).name}</span>
                        <strong>{video.data.title.replace(/\s*(#[\w-]+\s*)+$/, '').replace(/\s*\|\s*\d+\s*$/, '')}</strong>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </>
          ))}
        </details>
      )
    }
  </div>

  <script>
    const theater = document.querySelector('[data-theater]');
    if (theater) {
      const stage = theater.querySelector('.player');
      const titleEl = theater.querySelector('[data-theater-title]');
      const thesisEl = theater.querySelector('[data-theater-thesis]');
      const channelEl = theater.querySelector('[data-theater-channel]');
  
      theater.querySelectorAll<HTMLButtonElement>('button.clip').forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.id;
          const title = button.dataset.title ?? '';
          if (!id || !stage) return;
  
          theater.querySelectorAll('button.clip').forEach((item) => item.classList.remove('is-current'));
          button.classList.add('is-current');
  
          if (titleEl) titleEl.textContent = title;
          if (thesisEl) thesisEl.textContent = button.dataset.thesis ?? '';
          if (channelEl) channelEl.textContent = button.dataset.channel ?? '';
  
          const poster = stage.querySelector<HTMLImageElement>('.player-poster');
          const play = stage.querySelector<HTMLButtonElement>('.player-play');
          const fallback = stage.querySelector<HTMLAnchorElement>('.player-fallback');
          stage.querySelector('iframe')?.remove();
          stage.classList.remove('is-playing');
          stage.setAttribute('data-embed', `https://www.youtube.com/embed/${id}?rel=0&autoplay=1`);
          if (poster) poster.src = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
          if (play) play.setAttribute('aria-label', `Play ${title}`);
          if (fallback) fallback.href = `https://www.youtube.com/watch?v=${id}`;
          play?.click();
        });
      });
    }
  </script>
</Base>
