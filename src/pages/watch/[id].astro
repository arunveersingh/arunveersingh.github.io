---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import { channelById } from '../../data/site';

export async function getStaticPaths() {
  const videos = await getCollection('videos');
  return videos.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const channel = channelById(entry.data.channel);
---

<Base
  title={entry.data.title}
  description={entry.data.thesis}
  ogType="article"
  publishedTime={entry.data.published}
>
  <article class="page">
    <p class="kicker">Watch · {channel.name}</p>
    <h1 class="page-heading">{entry.data.title}</h1>
    <p class="lede">{entry.data.thesis}</p>
    {
      entry.data.youtubeId && (
        <Player youtubeId={entry.data.youtubeId} title={entry.data.title} />
      )
    }
    <p class="muted" style="margin-top: 1rem;">
      <a href={channel.href}>Open the channel</a>
      {
        entry.data.youtubeId && (
          <>
            {' · '}
            <a href={`https://www.youtube.com/watch?v=${entry.data.youtubeId}`}>
              Open on YouTube
            </a>
          </>
        )
      }
    </p>
  </article>
</Base>
