---
interface Props {
  name: 'studio' | 'essay' | 'play' | 'course' | 'build' | 'about' | 'clock' | 'skill';
}

const { name } = Astro.props;
---

<svg
  class="glyph"
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'studio' && (
      <>
        <circle cx="12" cy="12" r="3.1" />
        <path d="M12 3.4v1.7M12 18.9v1.7M3.4 12h1.7M18.9 12h1.7M5.8 5.8l1.2 1.2M17 17l1.2 1.2M18.2 5.8 17 7M7 17l-1.2 1.2" />
      </>
    )
  }
  {
    name === 'essay' && (
      <>
        <path d="M7 3.8h7.2L19 8.6V20.2H7z" />
        <path d="M14 3.8v5h5M9.2 12.2h6.2M9.2 15.6h4.4" />
      </>
    )
  }
  {name === 'play' && <path d="M9 7.2v9.6l8-4.8z" />}
  {
    name === 'course' && (
      <>
        <path d="M4.5 6.2 12 3.8l7.5 2.4v11.2L12 20.2 4.5 17.4z" />
        <path d="M12 3.8v16.4M4.5 6.2 12 8.8l7.5-2.6" />
      </>
    )
  }
  {
    name === 'build' && (
      <>
        <path d="M12 3.6 20 8v8l-8 4.4L4 16V8z" />
        <path d="M12 12 20 8M12 12v8.4M12 12 4 8" />
      </>
    )
  }
  {
    name === 'about' && (
      <>
        <circle cx="12" cy="8" r="2.7" />
        <path d="M6.2 19.2c.7-2.8 2.9-4.2 5.8-4.2s5.1 1.4 5.8 4.2" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="7.2" />
        <path d="M12 8.2V12l2.6 1.8" />
      </>
    )
  }
  {
    name === 'skill' && (
      <path d="M12 3.4 13.6 8H18.4l-3.8 2.9 1.5 4.7L12 12.8 7.9 15.6l1.5-4.7L5.6 8h4.8z" />
    )
  }
</svg>
